+/* ======================================================================================================================
+ * HEADROOM DIAGNOSTIC (this build only; not part of the co-op rules). Reads how much of the console's 64 MB is free while
+ * the game runs and writes it to E:\swrots_headroom.txt and to the block g_hr (see coop.sym), so we know how much
+ * room a level leaves for extra characters.
+ *   MmQueryStatistics (kernel export 181) is already imported by the game; NtCreateFile (190), NtWriteFile (236) and
+ *   NtClose (187) too. They are called through the game's own import table (the loader fills it with the kernel's addresses).
+ * ====================================================================================================================== */
+#define K_MmQueryStatistics 0x0055F6B8u
+#define K_NtClose           0x0055F6C0u
+#define K_NtWriteFile       0x0055F6DCu
+#define K_NtCreateFile      0x0055F700u
+#define HR_SLOTS   (KEYS + 2)          /* 0..KEYS-1 a level (by key), KEYS a level not named yet, KEYS+1 menus / loading */
+#define HR_EVERY   10                  /* frames between samples (about a third of a second) */
+#define HR_WRITE_EVERY 900             /* frames between file writes while playing (about 30 s), and one when a level ends */
+
+struct MmStats { u32 length, totalPages, availPages, vmCommitted, vmReserved, cachePages, poolPages, stackPages, imagePages; };
+struct HrRec { u32 samples, first, min, max, last, p2Before, p2After, p2Min, frames; }; /* pages of 4 KB; 0 = none yet */
+struct HrDbg {
+    volatile u32 magic, version, status;        /* 'HEAD', 1, bit0 stats work, bit1 file works */
+    volatile u32 writes, writeFails, calls, total;
+    volatile u32 now[8];                         /* the last MmStats: length, total, avail, committed, reserved, cache, pool, stack/image */
+    volatile u32 minEver, minEverSlot, maxMenu, bootFree;
+    struct HrRec rec[HR_SLOTS];
+};
+__attribute__((section(".coopdbg2"))) struct HrDbg g_hr = { .magic = 0x44414548u, .version = 1 };
+
+typedef i32 (__attribute__((stdcall)) *fnQuery)(struct MmStats*);
+typedef i32 (__attribute__((stdcall)) *fnCreate)(void**, u32, void*, void*, void*, u32, u32, u32, u32);
+typedef i32 (__attribute__((stdcall)) *fnWrite)(void*, void*, void*, void*, void*, const void*, u32, void*);
+typedef i32 (__attribute__((stdcall)) *fnClose)(void*);
+
+static u32 s_hrNext, s_hrLevelStart, s_hrWrite, s_hrDirty, s_hrP2Prev, s_hrP2At, s_hrLastP1, s_hrLastSlot = 0xFF;
+static u32 s_hrPrevFree;
+static int s_hrOk = 1;
+
+#ifndef HR_TEST
+static int hr_kernel_ok(u32 thunk) { u32 v = *(volatile u32*)thunk; return v >= 0x80000000u && v < 0x90000000u; }
+#else
+static int hr_kernel_ok(u32 thunk) { return *(volatile u32*)thunk != 0; }
+#endif
+
+static char* hr_dec(char* p, u32 v)
+{
+    char t[12]; int n = 0;
+    do { t[n++] = (char)('0' + v % 10); v /= 10; } while (v);
+    while (n) *p++ = t[--n];
+    return p;
+}
+static char* hr_str(char* p, const char* s) { while (*s) *p++ = *s++; return p; }
+static char* hr_kb(char* p, u32 pages) { return hr_str(hr_dec(p, pages * 4), pages ? " KB" : " -"); }  /* pages -> "123 KB" */
+
+static void hr_write_file(void)
+{
+    static char buf[3072];
+    char* p = buf;
+    p = hr_str(p, "SWROTS co-op mod v0.36 headroom diagnostic\r\nFree memory in KB (4 KB pages). Console total: ");
+    p = hr_kb(p, g_hr.total);
+    p = hr_str(p, "\r\nNow: free "); p = hr_kb(p, g_hr.now[2]);
+    p = hr_str(p, ", image "); p = hr_kb(p, g_hr.now[7]);
+    p = hr_str(p, ", pool "); p = hr_kb(p, g_hr.now[6]);
+    p = hr_str(p, ", cache "); p = hr_kb(p, g_hr.now[5]);
+    p = hr_str(p, "\r\nLowest free ever: "); p = hr_kb(p, g_hr.minEver);
+    p = hr_str(p, " (slot "); p = hr_dec(p, g_hr.minEverSlot);
+    p = hr_str(p, ")   Free in the menus at most: "); p = hr_kb(p, g_hr.maxMenu);
+    p = hr_str(p, "\r\n\r\nlevel  first(after load)  lowest  highest  P2 before -> after  (P2 lowest)\r\n");
+    for (u32 s = 0; s < HR_SLOTS; ++s) {
+        const struct HrRec* r = &g_hr.rec[s];
+        if (!r->samples) continue;
+        if (s < KEYS) { p = hr_str(p, "L"); p = hr_dec(p, s); }
+        else p = hr_str(p, s == KEYS ? "L?" : "menu");
+        p = hr_str(p, "   "); p = hr_kb(p, r->first);
+        p = hr_str(p, "   "); p = hr_kb(p, r->min);
+        p = hr_str(p, "   "); p = hr_kb(p, r->max);
+        if (r->p2After) {
+            p = hr_str(p, "   "); p = hr_kb(p, r->p2Before);
+            p = hr_str(p, " -> "); p = hr_kb(p, r->p2After);
+            p = hr_str(p, "  ("); p = hr_kb(p, r->p2Min); p = hr_str(p, ")");
+        }
+        p = hr_str(p, "\r\n");
+    }
+    u32 len = (u32)(p - buf);
+    static const char path[] = "\\Device\\Harddisk0\\Partition1\\swrots_headroom.txt";
+    struct { u16 len, max; const char* buf; } name = { sizeof(path) - 1, sizeof(path), path };
+    struct { void* root; void* name; u32 attr; } oa = { 0, &name, 0x40 };
+    u32 iosb[2] = { 0, 0 };
+    void* h = 0;
+    i32 st = ((fnCreate)*(u32*)K_NtCreateFile)(&h, 0x40100000u /* GENERIC_WRITE | SYNCHRONIZE */, &oa, iosb, 0, 0x80 /* NORMAL */, 0, 5 /* OVERWRITE_IF */, 0x60 /* NON_DIRECTORY | SYNC_IO_NONALERT */);
+    g_hr.writes++;
+    if (st < 0 || !h) { g_hr.writeFails++; if (g_hr.writeFails >= 3 && !(g_hr.status & 2)) s_hrOk = 0; return; }
+    u32 iosb2[2] = { 0, 0 };
+    st = ((fnWrite)*(u32*)K_NtWriteFile)(h, 0, 0, 0, iosb2, buf, len, 0);
+    ((fnClose)*(u32*)K_NtClose)(h);
+    if (st < 0) g_hr.writeFails++; else g_hr.status |= 2;
+}
+
+static void hr_tick(u32 now)
+{
+    if (!s_hrOk) return;
+    if (!g_hr.calls) { /* first time: are the kernel entries really there? */
+        if (!hr_kernel_ok(K_MmQueryStatistics)) { s_hrOk = 0; return; }
+        if (!hr_kernel_ok(K_NtCreateFile) || !hr_kernel_ok(K_NtWriteFile) || !hr_kernel_ok(K_NtClose)) g_hr.writeFails = 99;
+    }
+    u32 p1 = (u32)s_p1;
+    if (p1 != s_hrLastP1) { /* a level began, or ended */
+        if (s_hrLastP1 && g_hr.writeFails < 3 && s_hrDirty) { hr_write_file(); s_hrDirty = 0; s_hrWrite = now; } /* one when a level ends */
+        s_hrLastP1 = p1; s_hrLevelStart = now; s_hrP2Prev = 0; s_hrP2At = 0;
+    }
+    if (now < s_hrNext) return;
+    s_hrNext = now + HR_EVERY;
+
+    struct MmStats st; st.length = sizeof st;
+    if (((fnQuery)*(u32*)K_MmQueryStatistics)(&st) < 0) return;
+    g_hr.calls++; g_hr.status |= 1; g_hr.total = st.totalPages;
+    g_hr.now[0] = st.length; g_hr.now[1] = st.totalPages; g_hr.now[2] = st.availPages; g_hr.now[3] = st.vmCommitted >> 12;
+    g_hr.now[4] = st.vmReserved >> 12; g_hr.now[5] = st.cachePages; g_hr.now[6] = st.poolPages; g_hr.now[7] = st.imagePages;
+    u32 free = st.availPages, prevFree = s_hrPrevFree; s_hrPrevFree = free; 
+    if (!g_hr.bootFree) g_hr.bootFree = free;
+
+    u32 slot = p1 ? (s_key < KEYS ? s_key : KEYS) : KEYS + 1;
+    struct HrRec* r = &g_hr.rec[slot];
+    r->samples++; r->last = free; r->frames = now;
+    if (!r->min || free < r->min) { r->min = free; s_hrDirty = 1; }
+    if (free > r->max) { r->max = free; if (slot == KEYS + 1 && free > g_hr.maxMenu) g_hr.maxMenu = free; }
+    if (!g_hr.minEver || free < g_hr.minEver) { g_hr.minEver = free; g_hr.minEverSlot = slot; s_hrDirty = 1; }
+
+    if (p1) {
+        if (!r->first && now - s_hrLevelStart >= 150) { r->first = free; s_hrDirty = 1; } /* five seconds in: loading is over */
+        /* what a second player costs: the free memory just before player two exists and three seconds after */
+        u32 p2 = g_dbg.player2;
+        if (p2 && !s_hrP2Prev) { s_hrP2At = now + 90; r->p2Before = prevFree ? prevFree : free; r->p2After = 0; }
+        s_hrP2Prev = p2;
+        if (!p2) s_hrP2At = 0;
+        if (s_hrP2At && now >= s_hrP2At) { r->p2After = free; r->p2Min = free; s_hrP2At = 0; s_hrDirty = 1; }
+        if (r->p2After && free < r->p2Min) { r->p2Min = free; s_hrDirty = 1; }
+    }
+    if (s_hrLastSlot != slot) { s_hrLastSlot = slot; s_hrDirty = 1; }
+    if (p1 && s_hrDirty && now - s_hrWrite >= HR_WRITE_EVERY && g_hr.writeFails < 3) { hr_write_file(); s_hrDirty = 0; s_hrWrite = now; }
+}
+
+void coop_tick(void)
+{
+    coop_tick_main();
+    hr_tick(g_dbg.frames);
+}
